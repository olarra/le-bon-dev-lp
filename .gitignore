# Dependencies (yarn.lock stays tracked; patches/ is applied by patch-package on install and stays tracked too)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and cache
/.next/
/out/
/build

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment files (commit .env.example if one is added; never the real ones)
.env
.env.*
!.env.example

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Testing and coverage
/coverage

# Deployment
.vercel

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Claude Code local settings (shared project settings, if any, stay tracked)
.claude/settings.local.json

# Scratch files
_tmp_*
*.tmp
