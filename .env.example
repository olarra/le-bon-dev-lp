# Public origin used by canonical URLs, social images, the sitemap and structured data.
SITE_URL=https://lebondev.fr

# Mailjet API keys (server only; never prefix these with NEXT_PUBLIC_).
MAIL_MJ_API_KEY_PUBLIC=
MAIL_MJ_API_KEY_PRIVATE=
# Verified sender address and studio inbox, as in the reference project.
MAIL_USERNAME=hello@lebondev.fr

# Email artwork and required fonts were published on LWS on 2026-10-23.
# Use this public base in local, preview and production environments.
# Leave empty only to use the CID image fallback.
MAIL_ASSET_BASE_URL=https://lebondev.fr
